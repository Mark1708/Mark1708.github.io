{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "descriptionRu": {
      "type": "string"
    },
    "bodyRu": {
      "type": "string"
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "githubUrl": {
      "type": "string",
      "format": "uri"
    },
    "awesomeOpenCodeUrl": {
      "type": "string",
      "format": "uri"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "type": "number"
    },
    "stars": {
      "type": "number"
    },
    "image": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "summaryRu": {
      "type": "string"
    },
    "demonstrates": {
      "type": "string"
    },
    "demonstratesRu": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "problemRu": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "architectureRu": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisionsRu": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradeoffsRu": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roleRu": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "futureImprovements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "futureImprovementsRu": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "demoUrl": {
      "type": "string",
      "format": "uri"
    },
    "docsUrl": {
      "type": "string",
      "format": "uri"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featuresRu": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "archived",
        "wip"
      ]
    },
    "startDate": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "technologies",
    "order"
  ]
}
---
// biome-ignore-all lint/correctness/noUnusedImports lint/correctness/noUnusedVariables lint/style/useTemplate: Astro template bindings and required SEO URL concatenation.
import '../styles/global.css';
import Footer from '../components/footer/Footer.astro';
import Navbar from '../components/nav/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  ogType?: string;
  articlePublishedTime?: string;
  articleTags?: string[];
}

const {
  title = 'Mark Gurianov — Team Lead',
  description = 'Backend developer with 5+ years of experience. Java, Spring Boot, distributed systems. Stavropol, Russia.',
  lang = 'en',
  ogType = 'website',
  articlePublishedTime,
  articleTags,
} = Astro.props;

const siteUrl = 'https://mark1708.ru';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const isRu = lang === 'ru';
const socialImageUrl = `${siteUrl}/images/social/og-${isRu ? 'ru' : 'en'}.png`;
const socialImageAlt = isRu
  ? 'Техническое портфолио Марка Гурьянова — от тимлида к архитектору решений'
  : 'Mark Gurianov technical portfolio — Team Lead to Solution Architect';

// Phase 5 current-violet browser chrome. Phase 8 remaps light/dark to #F5F7F8/#020202.
const themeColors = Object.freeze({
  light: '#F3F5F9',
  dark: '#020306',
});
const initialThemeColor = themeColors.dark;

const enPath = isRu
  ? Astro.url.pathname.replace(/^\/ru(\/|$)/, '/') || '/'
  : Astro.url.pathname;
const enHref = siteUrl + enPath;
const ruHref = isRu ? canonicalUrl : siteUrl + '/ru' + Astro.url.pathname;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mark Gurianov',
  jobTitle: 'Team Lead & Backend Engineer',
  url: siteUrl,
  image: `${siteUrl}/profile.jpg`,
  email: 'mark1708.work@gmail.com',
  sameAs: [
    'https://github.com/Mark1708',
    'https://www.linkedin.com/in/mark1708/',
    'https://t.me/MarkStav',
  ],
};

const brandLogoLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  '@id': `${siteUrl}/#brand-logo`,
  name: 'Mark Gurianov logo',
  contentUrl: `${siteUrl}/brand/mark-gurianov-logo-horizontal.svg`,
  encodingFormat: 'image/svg+xml',
  creditText: 'Logo design by kovalév art — Evgeny Kovalev / Евгений Ковалев',
  creator: {
    '@type': 'Person',
    name: 'Evgeny Kovalev',
    alternateName: 'Евгений Ковалев',
    url: 'https://link.me/kovalev',
  },
};

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { name: isRu ? 'Главная' : 'Home', url: siteUrl + (isRu ? '/ru' : '') },
];
let breadcrumbPath = isRu ? '/ru' : '';
for (const segment of pathSegments) {
  if (segment === 'ru') continue;
  breadcrumbPath += '/' + segment;
  breadcrumbItems.push({ name: segment, url: siteUrl + breadcrumbPath });
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ru" href={ruHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={isRu ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={isRu ? 'en_US' : 'ru_RU'} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:site_name" content="Mark Gurianov" />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleTags && articleTags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta
      name="theme-color"
      content={initialThemeColor}
      data-theme-color-light={themeColors.light}
      data-theme-color-dark={themeColors.dark}
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Mark Gurianov',
      url: siteUrl,
    })} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(brandLogoLd)} />

    <!-- Anti-flash theme script -->
    <script is:inline>
      (function() {
        var THEME_KEY = 'portfolio-theme';
        var THEME_CHANGE_EVENT = 'portfolio-theme-change';
        var themeColorMeta = document.querySelector('meta[name="theme-color"]');
        var themeColors = Object.freeze({
          light: themeColorMeta.dataset.themeColorLight,
          dark: themeColorMeta.dataset.themeColorDark
        });
        var systemPreference = window.matchMedia('(prefers-color-scheme: dark)');

        function normalizeTheme(value) {
          return value === 'light' || value === 'dark' || value === 'system' ? value : 'system';
        }

        function readSavedTheme() {
          try {
            return normalizeTheme(localStorage.getItem('portfolio-theme'));
          } catch (error) {
            return 'system';
          }
        }

        function resolveTheme(mode) {
          return mode === 'system' ? (systemPreference.matches ? 'dark' : 'light') : mode;
        }

        function updateThemeColor(resolvedTheme) {
          themeColorMeta.content = themeColors[resolvedTheme];
          document.documentElement.style.colorScheme = resolvedTheme;
        }

        function applyThemeMode(mode) {
          currentMode = normalizeTheme(mode);
          document.documentElement.removeAttribute('data-theme');
          if (currentMode !== 'system') {
            document.documentElement.setAttribute('data-theme', currentMode);
          }
          updateThemeColor(resolveTheme(currentMode));
        }

        var currentMode = readSavedTheme();
        applyThemeMode(currentMode);

        window.addEventListener(THEME_CHANGE_EVENT, function(event) {
          applyThemeMode(event.detail);
        });

        window.addEventListener('storage', function(event) {
          if (event.key === THEME_KEY) applyThemeMode(event.newValue);
        });

        systemPreference.addEventListener('change', function() {
          if (currentMode === 'system') updateThemeColor(resolveTheme(currentMode));
        });
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <div class="page-offset">
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style>
  .page-offset {
    padding-top: 52px;
  }
</style>

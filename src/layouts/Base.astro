---
// biome-ignore-all lint/correctness/noUnusedImports lint/correctness/noUnusedVariables lint/style/useTemplate: Astro template bindings and required SEO URL concatenation.
import '../styles/global.css';
import Footer from '../components/footer/Footer.astro';
import Navbar from '../components/nav/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  image?: string;
  ogType?: string;
  articlePublishedTime?: string;
  articleTags?: string[];
}

const {
  title = 'Mark Gurianov — Team Lead',
  description = 'Backend developer with 5+ years of experience. Java, Spring Boot, distributed systems. Stavropol, Russia.',
  lang = 'en',
  image = '/profile.jpg',
  ogType = 'website',
  articlePublishedTime,
  articleTags,
} = Astro.props;

const siteUrl = 'https://mark1708.ru';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const isRu = lang === 'ru';
const socialImageAlt = isRu ? 'Портрет Марка Гурьянова' : 'Portrait of Mark Gurianov';

const enPath = isRu
  ? Astro.url.pathname.replace(/^\/ru(\/|$)/, '/') || '/'
  : Astro.url.pathname;
const enHref = siteUrl + enPath;
const ruHref = isRu ? canonicalUrl : siteUrl + '/ru' + Astro.url.pathname;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mark Gurianov',
  jobTitle: 'Team Lead & Backend Engineer',
  url: siteUrl,
  image: `${siteUrl}/profile.jpg`,
  email: 'mark1708.work@gmail.com',
  sameAs: [
    'https://github.com/Mark1708',
    'https://www.linkedin.com/in/mark1708/',
    'https://t.me/MarkStav',
  ],
};

const brandLogoLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  '@id': `${siteUrl}/#brand-logo`,
  name: 'Mark Gurianov logo',
  contentUrl: `${siteUrl}/brand/mark-gurianov-logo-horizontal.svg`,
  encodingFormat: 'image/svg+xml',
  creditText: 'Logo design by kovalév art — Evgeny Kovalev / Евгений Ковалев',
  creator: {
    '@type': 'Person',
    name: 'Evgeny Kovalev',
    alternateName: 'Евгений Ковалев',
    url: 'https://link.me/kovalev',
  },
};

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { name: isRu ? 'Главная' : 'Home', url: siteUrl + (isRu ? '/ru' : '') },
];
let breadcrumbPath = isRu ? '/ru' : '';
for (const segment of pathSegments) {
  if (segment === 'ru') continue;
  breadcrumbPath += '/' + segment;
  breadcrumbItems.push({ name: segment, url: siteUrl + breadcrumbPath });
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ru" href={ruHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={isRu ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={isRu ? 'en_US' : 'ru_RU'} />
    <meta property="og:image" content={siteUrl + image} />
    <meta property="og:image:width" content="1496" />
    <meta property="og:image:height" content="1496" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:site_name" content="Mark Gurianov" />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleTags && articleTags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta name="theme-color" content="#111827" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + image} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Mark Gurianov',
      url: siteUrl,
    })} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(brandLogoLd)} />

    <!-- Anti-flash theme script -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('portfolio-theme') || 'system';
        if (saved !== 'system') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <div class="page-offset">
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style>
  .page-offset {
    padding-top: 52px;
  }
</style>

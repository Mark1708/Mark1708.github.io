---
// biome-ignore-all lint/correctness/noUnusedImports: Astro templates reference frontmatter imports.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro templates reference frontmatter variables.
import type { CollectionEntry } from 'astro:content';
import { type ContentLang, getLocalePrefix } from '../../i18n/content';
import { useTranslations as getTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import Tag from '../ui/Tag.astro';

type MarkdownBlock =
  | { type: 'heading'; level: number; content: string }
  | { type: 'paragraph'; content: string }
  | { type: 'list'; items: string[] }
  | { type: 'code'; language: string; content: string };

interface Props {
  lang: ContentLang;
  article: CollectionEntry<'articles'>;
  Content: any;
}

const { lang, article, Content } = Astro.props;
const t = getTranslations(lang);
const localePrefix = getLocalePrefix(lang);
const title = lang === 'ru' ? article.data.title : article.data.titleEn;
const description = lang === 'ru' ? article.data.description : article.data.descriptionEn;
const sourceName = lang === 'ru' ? article.data.sourceNameRu : article.data.sourceName;
const readingMinutes = article.data.readingTime.replace(/\D/g, '') || article.data.readingTime;
const formattedDate = new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(article.data.date));

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderInlineMarkdown(value: string): string {
  return escapeHtml(value)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
}

function parseEnglishMarkdown(markdown: string): MarkdownBlock[] {
  const lines = markdown.trim().split('\n');
  const blocks: MarkdownBlock[] = [];
  let index = 0;

  while (index < lines.length) {
    const line = lines[index]?.trimEnd() ?? '';
    if (!line.trim()) {
      index += 1;
    } else if (line.startsWith('```')) {
      const language = line.slice(3).trim();
      const codeLines = [];
      index += 1;
      while (index < lines.length && !lines[index]?.startsWith('```')) {
        codeLines.push(lines[index] ?? '');
        index += 1;
      }
      blocks.push({ type: 'code', language, content: codeLines.join('\n') });
      index += 1;
    } else if (line.startsWith('## ')) {
      blocks.push({ type: 'heading', level: 2, content: line.slice(3).trim() });
      index += 1;
    } else if (line.startsWith('- ')) {
      const items = [];
      while (index < lines.length && lines[index]?.trim().startsWith('- ')) {
        items.push((lines[index] ?? '').trim().slice(2).trim());
        index += 1;
      }
      blocks.push({ type: 'list', items });
    } else {
      const paragraph = [];
      while (index < lines.length && lines[index]?.trim() && !lines[index]?.trim().startsWith('## ') && !lines[index]?.trim().startsWith('- ') && !lines[index]?.trim().startsWith('```')) {
        paragraph.push((lines[index] ?? '').trim());
        index += 1;
      }
      blocks.push({ type: 'paragraph', content: paragraph.join(' ') });
    }
  }

  return blocks;
}

const englishBlocks = lang === 'en' ? parseEnglishMarkdown(article.data.bodyEn) : [];
const pageTitle = `${title} — Mark Gurianov`;
const pageUrl = `https://mark1708.ru${localePrefix}/articles/${article.id}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: article.data.date,
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  author: {
    '@type': 'Person',
    name: 'Mark Gurianov',
    url: 'https://mark1708.ru',
  },
  publisher: {
    '@type': 'Person',
    name: 'Mark Gurianov',
  },
};
---

<Base
  title={pageTitle}
  description={description}
  lang={lang}
  ogType="article"
  articlePublishedTime={article.data.date}
  articleTags={article.data.tags}
>
  <article class="article-detail container">
    <a href={`${localePrefix || '/'}#articles`} class="article-detail__back">{t('article.back')}</a>

    <header class="article-detail__header">
      <p class="article-detail__source">{sourceName}</p>
      <h1 class="article-detail__title">{title}</h1>
      <p class="article-detail__description">{description}</p>

      <div class="article-detail__meta" aria-label="Article metadata">
        <time datetime={article.data.date}>{formattedDate}</time>
        <span>{readingMinutes} {t('article.readingTime')}</span>
        {article.data.readers && <span>{article.data.readers} {t('article.readers')}</span>}
      </div>

      <div class="article-detail__tags" aria-label="Article tags">
        {article.data.tags.map(tag => <Tag label={tag} />)}
      </div>

      {article.data.links && article.data.links.length > 0 && (
        <div class="article-detail__links">
          {article.data.links.map(link => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="article-detail__source-link">
              {lang === 'ru' ? link.labelRu : link.label} ↗
            </a>
          ))}
        </div>
      )}

      {article.data.files && article.data.files.length > 0 && (
        <div class="article-detail__attachments">
          <h2 class="article-detail__attachments-title">{t('article.attachments')}</h2>
          <div class="article-detail__attachments-list">
            {article.data.files.map(file => (
              <a href={file.url} download class="article-detail__download-link">
                <span class="article-detail__download-label">{lang === 'ru' ? file.labelRu : file.label}</span>
                <span class="article-detail__download-format">{file.format}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </header>

    {lang === 'ru' ? (
      <div class="article-detail__body">
        <Content />
      </div>
    ) : (
      <div class="article-detail__body">
        {englishBlocks.map(block => (
          block.type === 'heading' ? (
            <h2 set:html={renderInlineMarkdown(block.content)} />
          ) : block.type === 'list' ? (
            <ul>{block.items.map(item => <li set:html={renderInlineMarkdown(item)} />)}</ul>
          ) : block.type === 'code' ? (
            <pre><code class={block.language ? `language-${block.language}` : undefined}>{block.content}</code></pre>
          ) : (
            <p set:html={renderInlineMarkdown(block.content)} />
          )
        ))}
      </div>
    )}

  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style>
    .article-detail {
      max-width: 720px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4);
    }

    .article-detail__back {
      display: inline-flex;
      align-items: center;
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      text-decoration: none;
      margin-bottom: var(--space-6);
      transition: color var(--duration-fast) var(--ease-out);
    }

    .article-detail__back:hover {
      color: var(--color-accent);
      opacity: 1;
    }

    .article-detail__header {
      margin-bottom: var(--space-8);
    }

    .article-detail__source {
      color: var(--color-accent);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.08em;
      margin-bottom: var(--space-3);
      text-transform: uppercase;
    }

    .article-detail__title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: var(--space-4);
    }

    .article-detail__description {
      color: var(--color-text-muted);
      font-size: var(--text-lg);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .article-detail__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      margin-bottom: var(--space-4);
    }

    .article-detail__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-5);
    }

    .article-detail__source-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      padding: var(--space-2) var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      text-decoration: none;
      transition:
        border-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
    }

    .article-detail__source-link:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      opacity: 1;
    }

    .article-detail__body {
      color: var(--color-text-muted);
      font-size: var(--text-base);
      line-height: 1.8;
    }

    .article-detail__body :global(h2) {
      color: var(--color-text);
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.25;
      margin: var(--space-8) 0 var(--space-4);
    }

    .article-detail__body :global(p),
    .article-detail__body :global(ul),
    .article-detail__body :global(pre) {
      margin-bottom: var(--space-5);
    }

    .article-detail__body :global(ul) {
      padding-left: var(--space-5);
    }

    .article-detail__body :global(li) {
      margin-bottom: var(--space-2);
    }

    .article-detail__body :global(a) {
      color: var(--color-accent);
      text-decoration: none;
    }

    .article-detail__body :global(a:hover) {
      opacity: 0.8;
    }

    .article-detail__body :global(code) {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      color: var(--color-text);
      font-family: var(--font-mono);
      font-size: 0.9em;
      padding: 0.1em 0.35em;
    }

    .article-detail__body :global(pre) {
      background: #0f172a;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      overflow-x: auto;
      padding: var(--space-4);
    }

    .article-detail__body :global(pre code) {
      background: transparent;
      border: 0;
      color: #e5e7eb;
      display: block;
      font-size: var(--text-sm);
      line-height: 1.7;
      padding: 0;
      white-space: pre;
    }

    .article-detail__links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }

    .article-detail__attachments {
      margin-bottom: var(--space-5);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
    }

    .article-detail__attachments-title {
      color: var(--color-text);
      font-family: var(--font-display);
      font-size: var(--text-sm);
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: var(--space-3);
    }

    .article-detail__attachments-list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .article-detail__download-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-5);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      font-weight: 500;
      text-decoration: none;
      transition:
        border-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
    }

    .article-detail__download-link:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      opacity: 1;
    }

    .article-detail__download-format {
      padding: 0.1em 0.4em;
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      color: var(--color-text-muted);
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
    }
  </style>
</Base>

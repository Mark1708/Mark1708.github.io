---
// biome-ignore-all lint/correctness/noUnusedImports: Astro templates reference frontmatter imports.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro templates reference frontmatter variables.
import type { CollectionEntry } from 'astro:content';
import { type ContentLang, getLocalePrefix } from '../../i18n/content';
import { useTranslations as getTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import Tag from '../ui/Tag.astro';

type MarkdownBlock =
  | { type: 'heading'; level: number; content: string }
  | { type: 'paragraph'; content: string }
  | { type: 'list'; items: string[] }
  | { type: 'code'; language: string; content: string };

type MarkdownContentComponent = (_props: Record<string, never>) => unknown;

interface Props {
  lang: ContentLang;
  article: CollectionEntry<'articles'>;
  Content: MarkdownContentComponent;
}

const { lang, article, Content } = Astro.props;
const t = getTranslations(lang);
const localePrefix = getLocalePrefix(lang);
const title = lang === 'ru' ? article.data.title : article.data.titleEn;
const description = lang === 'ru' ? article.data.description : article.data.descriptionEn;
const sourceName = lang === 'ru' ? article.data.sourceNameRu : article.data.sourceName;
const readingMinutes = article.data.readingTime.replace(/\D/g, '') || article.data.readingTime;
const formattedDate = new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(article.data.date));

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^\w\sа-яё-]/gi, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
}

function renderInlineMarkdown(value: string): string {
  return escapeHtml(value)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
}

function parseEnglishMarkdown(markdown: string): MarkdownBlock[] {
  const lines = markdown.trim().split('\n');
  const blocks: MarkdownBlock[] = [];
  let index = 0;

  while (index < lines.length) {
    const line = lines[index]?.trimEnd() ?? '';
    if (!line.trim()) {
      index += 1;
    } else if (line.startsWith('```')) {
      const language = line.slice(3).trim();
      const codeLines = [];
      index += 1;
      while (index < lines.length && !lines[index]?.startsWith('```')) {
        codeLines.push(lines[index] ?? '');
        index += 1;
      }
      blocks.push({ type: 'code', language, content: codeLines.join('\n') });
      index += 1;
    } else if (line.startsWith('## ')) {
      blocks.push({ type: 'heading', level: 2, content: line.slice(3).trim() });
      index += 1;
    } else if (line.startsWith('- ')) {
      const items = [];
      while (index < lines.length && lines[index]?.trim().startsWith('- ')) {
        items.push((lines[index] ?? '').trim().slice(2).trim());
        index += 1;
      }
      blocks.push({ type: 'list', items });
    } else {
      const paragraph = [];
      while (index < lines.length && lines[index]?.trim() && !lines[index]?.trim().startsWith('## ') && !lines[index]?.trim().startsWith('- ') && !lines[index]?.trim().startsWith('```')) {
        paragraph.push((lines[index] ?? '').trim());
        index += 1;
      }
      blocks.push({ type: 'paragraph', content: paragraph.join(' ') });
    }
  }

  return blocks;
}

const englishBlocks = lang === 'en' ? parseEnglishMarkdown(article.data.bodyEn) : [];
const pageTitle = `${title} — Mark Gurianov`;
const pageUrl = `https://mark1708.ru${localePrefix}/articles/${article.id}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: article.data.date,
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  author: {
    '@type': 'Person',
    name: 'Mark Gurianov',
    url: 'https://mark1708.ru',
  },
  publisher: {
    '@type': 'Person',
    name: 'Mark Gurianov',
  },
};
---

<Base
  title={pageTitle}
  description={description}
  lang={lang}
  ogType="article"
  articlePublishedTime={article.data.date}
  articleTags={article.data.tags}
>
  <article class="article-detail container">
    <a href={`${localePrefix || '/'}#articles`} class="article-detail__back">{t('article.back')}</a>

    <div class="article-detail__layout">
      <div class="article-detail__main">
        <header class="article-detail__header">
          <p class="article-detail__source">{sourceName}</p>
          <h1 class="article-detail__title">{title}</h1>
          <p class="article-detail__description">{description}</p>

          <div class="article-detail__meta" aria-label="Article metadata">
            <time datetime={article.data.date}>{formattedDate}</time>
            <span>{readingMinutes} {t('article.readingTime')}</span>
            {article.data.readers && <span>{article.data.readers} {t('article.readers')}</span>}
          </div>

          <div class="article-detail__tags" aria-label="Article tags">
            {article.data.tags.map(tag => <Tag label={tag} />)}
          </div>

          {article.data.links && article.data.links.length > 0 && (
            <div class="article-detail__links">
              {article.data.links.map(link => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="article-detail__source-link">
                  {lang === 'ru' ? link.labelRu : link.label} ↗
                </a>
              ))}
            </div>
          )}

          {article.data.files && article.data.files.length > 0 && (
            <div class="article-detail__attachments">
              <h2 class="article-detail__attachments-title">{t('article.attachments')}</h2>
              <div class="article-detail__attachments-list">
                {article.data.files.map(file => (
                  <a href={file.url} download class="article-detail__download-link">
                    <span class="article-detail__download-label">{lang === 'ru' ? file.labelRu : file.label}</span>
                    <span class="article-detail__download-format">{file.format}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </header>

        {lang === 'ru' ? (
          <div class="article-detail__body">
            <Content />
          </div>
        ) : (
          <div class="article-detail__body">
            {englishBlocks.map(block => (
              block.type === 'heading' ? (
                <h2 id={slugify(block.content)} set:html={renderInlineMarkdown(block.content)} />
              ) : block.type === 'list' ? (
                <ul>{block.items.map(item => <li set:html={renderInlineMarkdown(item)} />)}</ul>
              ) : block.type === 'code' ? (
                <pre><code class={block.language ? `language-${block.language}` : undefined}>{block.content}</code></pre>
              ) : (
                <p set:html={renderInlineMarkdown(block.content)} />
              )
            ))}
          </div>
        )}
      </div>

      <nav class="article-detail__toc" aria-label="Section navigation">
        <p class="article-detail__toc-title">{t('article.toc')}</p>
        <div class="article-detail__toc-track">
          <div class="article-detail__toc-fill" id="toc-fill"></div>
          <ol class="article-detail__toc-list"></ol>
        </div>
      </nav>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script>
    function initArticlePage(): void {
      const body = document.querySelector('.article-detail__body') as HTMLElement | null;
      if (!body) return;

      const headings = body.querySelectorAll('h2');
      const tocList = document.querySelector('.article-detail__toc-list') as HTMLOListElement | null;
      const tocTrack = document.querySelector('.article-detail__toc-track') as HTMLElement | null;

      // --- TOC nav-rail generation + scroll spy ---
      if (tocList && tocTrack && headings.length > 0) {
        headings.forEach((heading, index) => {
          if (!heading.id) {
            heading.id = heading.textContent
              ?.toLowerCase()
              .replace(/[^\w\sа-яё-]/gi, '')
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-')
              .replace(/^-|-$/g, '') || `section-${index}`;
          }

          const li = document.createElement('li');
          li.className = 'article-detail__toc-item';
          li.tabIndex = 0;
          li.setAttribute('role', 'button');
          li.setAttribute('aria-label', heading.textContent || `Section ${index + 1}`);
          li.setAttribute('data-i', String(index));

          const label = document.createElement('span');
          label.className = 'article-detail__toc-label';
          label.textContent = heading.textContent;
          label.title = heading.textContent || `Section ${index + 1}`;

          const dot = document.createElement('span');
          dot.className = 'article-detail__toc-dot';
          dot.setAttribute('aria-hidden', 'true');

          li.appendChild(label);
          li.appendChild(dot);
          tocList.appendChild(li);
        });

        const tocFill = document.getElementById('toc-fill');
        const tocItems = tocList.querySelectorAll<HTMLElement>('.article-detail__toc-item');
        const headingArray = Array.from(headings);
        let activeTocIndex = -1;
        let activeUpdateFrame = 0;
        let fillUpdateFrame = 0;

        const getDotCenterInTrack = (dot: HTMLElement): number => {
          const trackRect = tocTrack.getBoundingClientRect();
          const dotRect = dot.getBoundingClientRect();

          return dotRect.top - trackRect.top + tocTrack.scrollTop + dotRect.height / 2;
        };

        const updateTocFill = (): void => {
          if (!tocFill || tocItems.length === 0) return;

          const firstItem = tocItems[0];
          const lastItem = tocItems[tocItems.length - 1];
          const activeItem = tocList.querySelector<HTMLElement>('.article-detail__toc-item--active') || firstItem;
          const firstDot = firstItem?.querySelector<HTMLElement>('.article-detail__toc-dot');
          const lastDot = lastItem?.querySelector<HTMLElement>('.article-detail__toc-dot');
          const activeDot = activeItem?.querySelector<HTMLElement>('.article-detail__toc-dot');

          if (!firstDot || !lastDot || !activeDot) return;

          const firstCenter = getDotCenterInTrack(firstDot);
          const activeCenter = getDotCenterInTrack(activeDot);
          const lastCenter = getDotCenterInTrack(lastDot);
          const fillHeight = Math.max(0, activeCenter - firstCenter);

          tocTrack.style.setProperty('--toc-line-top', `${firstCenter}px`);
          tocTrack.style.setProperty('--toc-line-height', `${Math.max(0, lastCenter - firstCenter)}px`);
          tocFill.style.top = `${firstCenter}px`;
          tocFill.style.height = `${fillHeight}px`;
        };

        const scheduleTocFillUpdate = (): void => {
          if (fillUpdateFrame) return;

          fillUpdateFrame = window.requestAnimationFrame(() => {
            fillUpdateFrame = 0;
            updateTocFill();
          });
        };

        const keepActiveItemVisible = (item: HTMLElement): void => {
          const trackRect = tocTrack.getBoundingClientRect();
          const itemRect = item.getBoundingClientRect();
          const padding = 12;

          if (itemRect.top < trackRect.top + padding) {
            tocTrack.scrollTo({
              top: tocTrack.scrollTop + itemRect.top - trackRect.top - padding,
              behavior: 'smooth',
            });
          } else if (itemRect.bottom > trackRect.bottom - padding) {
            tocTrack.scrollTo({
              top: tocTrack.scrollTop + itemRect.bottom - trackRect.bottom + padding,
              behavior: 'smooth',
            });
          }

          scheduleTocFillUpdate();
        };

        const setActiveTocItem = (idx: number): void => {
          if (idx < 0 || idx >= tocItems.length) return;

          tocItems.forEach((item) => {
            const isActive = Number(item.dataset.i) === idx;
            item.classList.toggle('article-detail__toc-item--active', isActive);

            if (isActive) {
              item.setAttribute('aria-current', 'true');
            } else {
              item.removeAttribute('aria-current');
            }
          });

          const activeItem = tocItems[idx];
          if (activeItem) {
            const activeChanged = activeTocIndex !== idx;
            activeTocIndex = idx;

            if (activeChanged) {
              keepActiveItemVisible(activeItem);
            } else {
              scheduleTocFillUpdate();
            }
          }
        };

        const updateActiveFromScroll = (): void => {
          const offset = Math.min(window.innerHeight * 0.35, 280);
          const isNearBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
          if (isNearBottom) {
            setActiveTocItem(headingArray.length - 1);
            return;
          }

          const currentIndex = headingArray.reduce((activeIndex, heading, index) => {
            return heading.getBoundingClientRect().top <= offset ? index : activeIndex;
          }, 0);

          setActiveTocItem(currentIndex);
        };

        const scheduleActiveUpdate = (): void => {
          if (activeUpdateFrame) return;

          activeUpdateFrame = window.requestAnimationFrame(() => {
            activeUpdateFrame = 0;
            updateActiveFromScroll();
          });
        };

        const observer = new IntersectionObserver(
          () => scheduleActiveUpdate(),
          { rootMargin: '-30% 0px -60% 0px', threshold: [0, 0.1] },
        );

        headings.forEach((h) => observer.observe(h));
        updateActiveFromScroll();
        window.addEventListener('scroll', scheduleActiveUpdate, { passive: true });
        window.addEventListener('resize', () => {
          scheduleActiveUpdate();
          scheduleTocFillUpdate();
        }, { passive: true });
        window.addEventListener('load', () => {
          scheduleActiveUpdate();
          scheduleTocFillUpdate();
        }, { once: true });
        tocTrack.addEventListener('scroll', scheduleTocFillUpdate, { passive: true });
        const resizeObserver = new ResizeObserver(() => {
          scheduleActiveUpdate();
          scheduleTocFillUpdate();
        });
        resizeObserver.observe(body);
        resizeObserver.observe(tocTrack);

        // Click-to-scroll
        tocItems.forEach((item) => {
          item.addEventListener('click', () => {
            const idx = parseInt(item.getAttribute('data-i') || '0', 10);
            const target = headingArray[idx];
            if (target) {
              setActiveTocItem(idx);
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              window.setTimeout(scheduleTocFillUpdate, 350);
            }
          });
          item.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;

            event.preventDefault();
            item.click();
          });
        });
      }

      // --- Callout detection ---
      const blockquotes = body.querySelectorAll('blockquote');
      blockquotes.forEach((bq) => {
        const firstP = bq.querySelector('p');
        if (!firstP) return;

        const text = firstP.textContent?.trim() || '';
        const strong = firstP.querySelector('strong');

        if (strong && text.startsWith('Вопросы управленцу')) {
          bq.setAttribute('data-callout', 'question');
        } else if (strong && firstP.childNodes.length <= 3 && strong.textContent?.trim() === text) {
          bq.setAttribute('data-callout', 'key');
        } else {
          bq.setAttribute('data-callout', 'insight');
        }
      });

      // --- Table scroll wrapper ---
      const tables = body.querySelectorAll('table');
      tables.forEach((table) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'article-detail__table-scroll';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      });
    }

    initArticlePage();
  </script>

  <style>
    /* ─── Layout ─── */
    .article-detail {
      max-width: 720px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4);
    }

    .article-detail__layout {
      display: flex;
      gap: 0;
    }

    .article-detail__main {
      flex: 1;
      min-width: 0;
      max-width: 100%;
    }

    .article-detail__toc {
      display: none;
    }

    @media (min-width: 1024px) {
      .article-detail {
        max-width: 1020px;
      }

      .article-detail__layout {
        align-items: flex-start;
        gap: var(--space-8);
        justify-content: center;
      }

      .article-detail__main {
        max-width: 720px;
      }

      .article-detail__toc {
        display: none;
      }
    }

    @media (min-width: 1280px) {
      .article-detail {
        max-width: 1120px;
      }

      .article-detail__toc {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        flex: 0 0 300px;
        position: sticky;
        top: 60px;
        z-index: 20;
        width: 300px;
        max-height: calc(100vh - 120px);
        min-height: 0;
        overflow: hidden;
      }
    }

    /* ─── Back link ─── */
    .article-detail__back {
      display: inline-flex;
      align-items: center;
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      text-decoration: none;
      margin-bottom: var(--space-6);
      transition: color var(--duration-fast) var(--ease-out);
    }

    .article-detail__back:hover {
      color: var(--color-accent);
      opacity: 1;
    }

    /* ─── Header ─── */
    .article-detail__header {
      margin-bottom: var(--space-8);
    }

    .article-detail__source {
      color: var(--color-accent);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.08em;
      margin-bottom: var(--space-3);
      text-transform: uppercase;
    }

    .article-detail__title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin-bottom: var(--space-4);
    }

    .article-detail__description {
      color: var(--color-text-muted);
      font-size: var(--text-lg);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .article-detail__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      margin-bottom: var(--space-4);
    }

    .article-detail__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: 1.25rem;
    }

    .article-detail__source-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      padding: var(--space-2) var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      text-decoration: none;
      transition:
        border-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
    }

    .article-detail__source-link:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      opacity: 1;
    }

    /* ─── Body: base ─── */
    .article-detail__body {
      color: var(--color-text-muted);
      font-size: var(--text-base);
      line-height: 1.8;
    }

    /* ─── Body: headings ─── */
    .article-detail__body :global(h2) {
      color: var(--color-text);
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.25;
      margin: var(--space-12) 0 var(--space-4);
      padding-top: var(--space-4);
      scroll-margin-top: 5rem;
      border-top: 1px solid var(--color-border);
    }

    .article-detail__body :global(h3) {
      color: var(--color-text);
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.3;
      margin: var(--space-6) 0 var(--space-3);
      scroll-margin-top: 5rem;
      padding-left: var(--space-3);
      border-left: 2px solid var(--color-accent);
    }

    .article-detail__body :global(h4) {
      color: var(--color-text);
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.3;
      margin: var(--space-6) 0 var(--space-3);
      scroll-margin-top: 5rem;
    }

    /* ─── Body: prose elements ─── */
    .article-detail__body :global(p),
    .article-detail__body :global(ul),
    .article-detail__body :global(ol) {
      margin-bottom: 1.25rem;
    }

    .article-detail__body :global(blockquote) {
      margin-bottom: var(--space-8);
      margin-top: var(--space-6);
    }

    .article-detail__body :global(table) {
      margin-bottom: 0;
    }

    .article-detail__body :global(hr) {
      margin-bottom: var(--space-12);
      margin-top: var(--space-12);
    }

    .article-detail__body :global(figure) {
      margin-bottom: var(--space-8);
      margin-top: var(--space-6);
    }

    .article-detail__body :global(pre) {
      margin-bottom: var(--space-8);
      margin-top: var(--space-4);
    }

    .article-detail__body :global(ul),
    .article-detail__body :global(ol) {
      padding-left: 2rem;
    }

    .article-detail__body :global(ol) {
      list-style-position: outside;
    }

    .article-detail__body :global(li) {
      margin-bottom: var(--space-3);
      padding-left: var(--space-1);
    }

    .article-detail__body :global(li::marker) {
      color: var(--color-accent);
      font-weight: 700;
    }

    .article-detail__body :global(strong) {
      color: var(--color-text);
      font-weight: 700;
    }

    .article-detail__body :global(em) {
      color: var(--color-text);
    }

    /* ─── Body: blockquotes (callout variants) ─── */
    .article-detail__body :global(blockquote) {
      background: var(--color-surface);
      border-left: var(--space-1) solid var(--color-accent);
      border-radius: var(--radius-md);
      color: var(--color-text);
      margin-left: 0;
      margin-right: 0;
      padding: 1.25rem var(--space-6);
      transition: background var(--duration-fast) var(--ease-out);
    }

    .article-detail__body :global(blockquote p),
    .article-detail__body :global(blockquote ul),
    .article-detail__body :global(blockquote ol) {
      max-width: 100%;
    }

    .article-detail__body :global(blockquote ul),
    .article-detail__body :global(blockquote ol) {
      margin-top: var(--space-3);
      padding-left: var(--space-6);
    }

    .article-detail__body :global(blockquote li) {
      margin-bottom: var(--space-2);
      padding-left: var(--space-1);
    }

    .article-detail__body :global(blockquote li:last-child) {
      margin-bottom: 0;
    }

    .article-detail__body :global(blockquote[data-callout="key"]) {
      background: var(--color-surface);
      border-left-color: var(--color-accent);
    }

    .article-detail__body :global(blockquote[data-callout="question"]) {
      background: var(--color-accent-glow);
      border-left-color: oklch(70% 0.15 80);
    }

    .article-detail__body :global(blockquote[data-callout="insight"]) {
      background: var(--color-surface-2);
      border-left-color: oklch(60% 0.1 260);
    }

    .article-detail__body :global(blockquote p:last-child) {
      margin-bottom: 0;
    }

    .article-detail__body :global(blockquote ul:last-child),
    .article-detail__body :global(blockquote ol:last-child) {
      margin-bottom: 0;

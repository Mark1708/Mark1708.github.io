---
// biome-ignore-all lint/correctness/noUnusedImports: Astro templates reference frontmatter imports.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro templates reference frontmatter variables.
import { getCollection } from 'astro:content';
import { type ContentLang, getLocalePrefix, getLocalizedContent } from '../../i18n/content';
import { useTranslations as getTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  lang: ContentLang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const localePrefix = getLocalePrefix(lang);
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

function getProjectGroup(technologies: string[], isFeatured: boolean): string {
  if (isFeatured) return lang === 'ru' ? 'Избранные' : 'Featured';
  if (technologies.some(tech => ['Spring Boot', 'Quarkus', 'Vert.x'].includes(tech))) return 'Backend';
  if (technologies.some(tech => ['Docker', 'PostgreSQL', 'Consul'].includes(tech))) return lang === 'ru' ? 'DevOps / инфраструктура' : 'DevOps / Infrastructure';
  if (technologies.some(tech => ['OpenCode Plugin API', 'Bun', 'Bubble Tea', 'Cobra'].includes(tech))) return lang === 'ru' ? 'AI / инструменты' : 'AI / Tools';
  if (technologies.some(tech => ['GFPGAN', 'DeOldify', 'PyTorch', 'EEG'].includes(tech))) return lang === 'ru' ? 'Учебные / экспериментальные' : 'Learning / Experiments';
  return 'Open Source';
}
---

<Base title={t('page.projects.title')} description={t('page.projects.description')} lang={lang}>
  <section class="projects-page container">
    <header class="projects-page__header">
      <h1 class="projects-page__title">{t('projects.title')}</h1>
    </header>

    <div class="projects-page__grid">
      {projects.map(project => {
        const content = getLocalizedContent(project.data, lang);
        const demonstrates = content.demonstrates?.trim();
        const group = getProjectGroup(project.data.technologies, project.data.featured);

        return (
          <article class="projects-page__card">
            <div class="projects-page__badges">
              <span class="projects-page__badge">{group}</span>
              <span class="projects-page__badge projects-page__badge--status">{t(`project.status.${project.data.status}`)}</span>
            </div>
            <h2 class="projects-page__card-title">
              <a href={`${localePrefix}/projects/${project.id}`}>
                {content.title}
              </a>
              {project.data.githubUrl && (
                <a
                  href={project.data.githubUrl}
                  class="projects-page__card-ext"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${content.title} on GitHub`}
                >
                  ↗
                </a>
              )}
            </h2>
            <p class="projects-page__card-desc">{content.summary || content.description}</p>
            {demonstrates && (
              <p class="projects-page__demonstrates">
                <span>{t('featuredProjects.demonstrates')}:</span> {demonstrates}
              </p>
            )}
            <div class="projects-page__card-tags">
              {project.data.technologies.map(tech => <Tag label={tech} />)}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .projects-page {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .projects-page__header {
    margin-bottom: var(--space-8);
  }

  .projects-page__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .projects-page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .projects-page__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .projects-page__card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
  }

  .projects-page__card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .projects-page__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .projects-page__badge {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 2px var(--space-2);
  }

  .projects-page__badge--status {
    color: var(--color-text-muted);
  }

  .projects-page__card-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .projects-page__card-title a:hover {
    color: var(--color-accent);
  }

  .projects-page__card-ext {
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .projects-page__card-ext:hover {
    color: var(--color-accent);
  }

  .projects-page__card:hover .projects-page__card-ext {
    transform: translate(2px, -2px);
  }

  .projects-page__card-desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    flex: 1;
  }

  .projects-page__demonstrates {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    padding-top: var(--space-4);
  }

  .projects-page__demonstrates span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .projects-page__card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>

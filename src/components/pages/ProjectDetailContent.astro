---
// biome-ignore-all lint/correctness/noUnusedImports: Astro templates reference frontmatter imports.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro templates reference frontmatter variables.
import type { CollectionEntry } from 'astro:content';
import { type ContentLang, getLocalePrefix, getLocalizedContent } from '../../i18n/content';
import { useTranslations as getTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  lang: ContentLang;
  project: CollectionEntry<'projects'>;
}

const { lang, project } = Astro.props;
const t = getTranslations(lang);
const localePrefix = getLocalePrefix(lang);
const content = getLocalizedContent(project.data, lang);
const { title, description, summary, features } = content;
const { technologies, githubUrl, stars } = project.data;

const pageTitle = `${title} — Mark Gurianov`;
const pageDescription = summary || description;
const bodyRuParagraphs = lang === 'ru' && project.data.bodyRu
  ? project.data.bodyRu.split('\n\n').map(paragraph => paragraph.trim()).filter(Boolean)
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  description: pageDescription,
  url: `https://mark1708.ru${localePrefix}/projects/${project.id}`,
  ...(githubUrl && { codeRepository: githubUrl }),
  applicationCategory: 'DeveloperApplication',
  programmingLanguage: technologies.join(', '),
  author: {
    '@type': 'Person',
    name: 'Mark Gurianov',
    url: 'https://mark1708.ru',
  },
};
---

<Base title={pageTitle} description={pageDescription} lang={lang}>
  <section class="project-detail container">
    <a href={`/${lang === 'ru' ? 'ru/' : ''}#projects`} class="project-detail__back">{t('projects.back')}</a>

    <header class="project-detail__header">
      <h1 class="project-detail__title">{title}</h1>
      <p class="project-detail__description">{description}</p>

      <div class="project-detail__meta">
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="project-detail__github">
            {t('projects.github')} ↗
          </a>
        )}
        {stars != null && (
          <span class="project-detail__stars">{stars} {t('projects.stars')}</span>
        )}
      </div>
    </header>

    {features && features.length > 0 && (
      <section class="project-detail__section">
        <h2 class="project-detail__section-title">{t('projects.features')}</h2>
        <ul class="project-detail__features">
          {features.map(feature => (
            <li>{feature}</li>
          ))}
        </ul>
      </section>
    )}

    <section class="project-detail__section">
      <h2 class="project-detail__section-title">{t('projects.technologies')}</h2>
      <div class="project-detail__tags">
        {technologies.map(tech => (
          <Tag label={tech} />
        ))}
      </div>
    </section>

    {bodyRuParagraphs.length > 0 ? (
      <div class="project-detail__body">
        {bodyRuParagraphs.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>
    ) : (
      <div class="project-detail__body" set:html={project.body} />
    )}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style>
    .project-detail {
      max-width: 720px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4);
    }

    .project-detail__back {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      text-decoration: none;
      margin-bottom: var(--space-6);
      transition: color var(--duration-fast) var(--ease-out);
    }

    .project-detail__back:hover {
      color: var(--color-accent);
      opacity: 1;
    }

    .project-detail__header {
      margin-bottom: var(--space-8);
    }

    .project-detail__title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: var(--space-4);
    }

    .project-detail__description {
      color: var(--color-text-muted);
      font-size: var(--text-lg);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }

    .project-detail__meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .project-detail__github {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      padding: var(--space-2) var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      text-decoration: none;
      transition:
        border-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
    }

    .project-detail__github:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      opacity: 1;
    }

    .project-detail__stars {
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
    }

    .project-detail__section {
      margin-bottom: var(--space-6);
    }

    .project-detail__section-title {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: 700;
      margin-bottom: var(--space-4);
    }

    .project-detail__features {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .project-detail__features li {
      position: relative;
      padding-left: var(--space-4);
      color: var(--color-text-muted);
      line-height: 1.7;
    }

    .project-detail__features li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.6em;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-accent);
    }

    .project-detail__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .project-detail__body {
      color: var(--color-text-muted);
      line-height: 1.7;
    }

    .project-detail__body p {
      margin-bottom: var(--space-4);
    }
  </style>
</Base>

---
// biome-ignore-all lint/correctness/noUnusedImports: Astro templates reference frontmatter imports.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro templates reference frontmatter variables.
import type { CollectionEntry } from 'astro:content';
import { type ContentLang, getLocalePrefix } from '../../i18n/content';
import { useTranslations as getTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  lang: ContentLang;
  articles: CollectionEntry<'articles'>[];
}

const { lang, articles } = Astro.props;
const t = getTranslations(lang);
const localePrefix = getLocalePrefix(lang);
const dateFormatter = new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const emptyText = lang === 'ru'
  ? 'Публикации скоро появятся.'
  : 'Publications will appear here soon.';

const getArticleTitle = (article: CollectionEntry<'articles'>): string =>
  lang === 'ru' ? article.data.title : article.data.titleEn;

const getArticleDescription = (article: CollectionEntry<'articles'>): string =>
  lang === 'ru' ? article.data.description : article.data.descriptionEn;

const getArticleSourceName = (article: CollectionEntry<'articles'>): string =>
  lang === 'ru' ? article.data.sourceNameRu : article.data.sourceName;
---

<Base title={t('page.articles.title')} description={t('page.articles.description')} lang={lang}>
  <section class="articles-page container">
    <header class="articles-page__header">
      <h1 class="articles-page__title">{t('articles.title')}</h1>
      <p class="articles-page__description">{t('articles.description')}</p>
    </header>

    {articles.length > 0 ? (
      <div class="articles-page__grid">
        {articles.map(article => {
          const title = getArticleTitle(article);
          const description = getArticleDescription(article);
          const sourceName = getArticleSourceName(article);
          const readingMinutes = article.data.readingTime.replace(/\D/g, '') || article.data.readingTime;

          return (
            <article class="articles-page__card">
              <div class="articles-page__card-main">
                <p class="articles-page__source">{sourceName}</p>
                <h2 class="articles-page__card-title">
                  <a href={`${localePrefix}/articles/${article.id}`}>{title}</a>
                </h2>
                <p class="articles-page__card-desc">{description}</p>

                <div class="articles-page__meta" aria-label={lang === 'ru' ? 'Метаданные материала' : 'Article metadata'}>
                  <time datetime={article.data.date}>{dateFormatter.format(new Date(article.data.date))}</time>
                  <span>{readingMinutes} {t('article.readingTime')}</span>
                </div>

                <div class="articles-page__tags" aria-label={lang === 'ru' ? 'Теги материала' : 'Article tags'}>
                  {article.data.tags.map(tag => <Tag label={tag} />)}
                </div>
              </div>

              <div class="articles-page__actions">
                <a class="articles-page__detail-link" href={`${localePrefix}/articles/${article.id}`}>
                  {t('articles.readMore')}
                </a>

                {article.data.links && article.data.links.length > 0 && (
                  <div class="articles-page__external-links" aria-label={`${t('article.readOnSource')} ${sourceName}`}>
                    {article.data.links.map(link => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class="articles-page__external-link">
                        {lang === 'ru' ? link.labelRu : link.label} ↗
                      </a>
                    ))}
                  </div>
                )}

                {article.data.files && article.data.files.length > 0 && (
                  <div class="articles-page__attachments">
                    <p class="articles-page__attachments-title">{t('article.attachments')}</p>
                    <div class="articles-page__attachments-list">
                      {article.data.files.map(file => (
                        <a href={file.url} download class="articles-page__attachment-link">
                          <span>{lang === 'ru' ? file.labelRu : file.label}</span>
                          <span class="articles-page__attachment-format">{file.format}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="articles-page__empty">{emptyText}</p>
    )}
  </section>
</Base>

<style>
  .articles-page {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .articles-page__header {
    margin-bottom: var(--space-8);
    max-width: 720px;
  }

  .articles-page__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .articles-page__description {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .articles-page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-6);
  }

  .articles-page__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .articles-page__card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-4px);
  }

  .articles-page__card-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-4);
  }

  .articles-page__source,
  .articles-page__attachments-title {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .articles-page__card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.3;
  }

  .articles-page__card-title a,
  .articles-page__detail-link,
  .articles-page__external-link,
  .articles-page__attachment-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .articles-page__card-title a:hover,
  .articles-page__detail-link:hover,
  .articles-page__external-link:hover,
  .articles-page__attachment-link:hover {
    color: var(--color-link-hover);
  }

  .articles-page__card-desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    flex: 1;
  }

  .articles-page__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .articles-page__tags,
  .articles-page__external-links,
  .articles-page__attachments-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .articles-page__actions,
  .articles-page__attachments {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .articles-page__detail-link,
  .articles-page__external-link,
  .articles-page__attachment-link {
    width: fit-content;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .articles-page__attachment-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
  }

  .articles-page__attachment-format {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .articles-page__empty {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
    padding: var(--space-6);
  }
</style>

---
// biome-ignore-all lint/correctness/noUnusedImports: Astro templates reference frontmatter imports.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro templates reference frontmatter variables.
import social from '../../data/social.json';
import type { ContentLang } from '../../i18n/content';
import { useTranslations as getTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import Timeline from '../experience/Timeline.astro';
import HeroSection from '../hero/HeroSection.astro';
import FeaturedProjects from '../projects/FeaturedProjects.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import ArticlesSection from '../sections/ArticlesSection.astro';
import SkillGrid from '../skills/SkillGrid.astro';

interface Props {
  lang: ContentLang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const title = lang === 'ru' ? 'Марк Гурьянов — Team Lead' : 'Mark Gurianov — Team Lead';
const description = lang === 'ru'
  ? 'Backend-разработчик с 5+ годами коммерческого опыта. Java, Spring Boot, распределённые системы. Ставрополь.'
  : undefined;
const footerName = t('footer.text') || (lang === 'ru' ? social.name : social.nameEn);
---

<Base lang={lang} title={title} description={description}>
  <main>
    <HeroSection lang={lang} />
    <Timeline lang={lang} />
    <SkillGrid lang={lang} />
    <FeaturedProjects lang={lang} />
    <ArticlesSection lang={lang} />
    <ProjectCard lang={lang} />

    <footer class="footer">
      <div class="container">
        <p class="footer__text">{footerName} · {new Date().getFullYear()}</p>
      </div>
    </footer>
  </main>
</Base>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-8);
  }
  .footer__text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>

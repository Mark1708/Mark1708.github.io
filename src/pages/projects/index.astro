---
// biome-ignore-all lint/correctness/noUnusedImports: Astro templates reference frontmatter imports.
// biome-ignore-all lint/correctness/noUnusedVariables: Astro templates reference frontmatter variables.
import { getCollection } from 'astro:content';
import Tag from '../../components/ui/Tag.astro';
import { useTranslations as getTranslations } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

const t = getTranslations('en');
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title={t('page.projects.title')} description={t('page.projects.description')} lang="en">
  <section class="projects-page container">
    <header class="projects-page__header">
      <h1 class="projects-page__title">{t('projects.title')}</h1>
    </header>

    <div class="projects-page__grid">
      {projects.map(project => (
        <article class="projects-page__card">
          <h2 class="projects-page__card-title">
            <a href={`/projects/${project.id}`}>
              {project.data.title}
            </a>
            {project.data.githubUrl && (
              <a
                href={project.data.githubUrl}
                class="projects-page__card-ext"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.data.title} on GitHub`}
              >
                ↗
              </a>
            )}
          </h2>
          <p class="projects-page__card-desc">{project.data.summary || project.data.description}</p>
          <div class="projects-page__card-tags">
            {project.data.technologies.map(tech => <Tag label={tech} />)}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .projects-page {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .projects-page__header {
    margin-bottom: var(--space-8);
  }

  .projects-page__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .projects-page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .projects-page__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .projects-page__card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
  }

  .projects-page__card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .projects-page__card-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .projects-page__card-title a:hover {
    color: var(--color-accent);
  }

  .projects-page__card-ext {
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .projects-page__card-ext:hover {
    color: var(--color-accent);
  }

  .projects-page__card:hover .projects-page__card-ext {
    transform: translate(2px, -2px);
  }

  .projects-page__card-desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    flex: 1;
  }

  .projects-page__card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
